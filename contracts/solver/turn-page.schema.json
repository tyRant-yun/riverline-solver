{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "anyOf": [
        {
          "type": "number",
          "const": 4
        },
        {
          "type": "number",
          "const": 5
        }
      ]
    },
    "path": {
      "maxItems": 24,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "action"
              },
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 128
              }
            },
            "required": [
              "kind",
              "index"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "deal"
              },
              "card": {
                "type": "string",
                "pattern": "^[2-9TJQKA][cdhs]$"
              }
            },
            "required": [
              "kind",
              "card"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "player": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        }
      ]
    },
    "counts": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "node": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "decision",
            "chance",
            "terminal"
          ]
        },
        "board": {
          "minItems": 3,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[2-9TJQKA][cdhs]$"
          }
        },
        "terminal": {
          "type": "boolean"
        },
        "player": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number",
                  "const": 0
                },
                {
                  "type": "number",
                  "const": 1
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "actions": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "chanceCards": {
          "maxItems": 48,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "card": {
                "type": "string",
                "pattern": "^[2-9TJQKA][cdhs]$"
              },
              "probability": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "card",
              "probability"
            ],
            "additionalProperties": false
          }
        },
        "invested": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "kind",
        "board",
        "terminal",
        "player",
        "actions",
        "chanceCards",
        "invested"
      ],
      "additionalProperties": false
    },
    "rows": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "combo": {
            "type": "string",
            "pattern": "^(?:[2-9TJQKA][cdhs]){2}$"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "compatibleMass": {
            "type": "number",
            "minimum": 0
          },
          "equity": {
            "type": "number"
          },
          "ev": {
            "type": "number"
          },
          "strategy": {
            "anyOf": [
              {
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1.000001
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "actionEv": {
            "anyOf": [
              {
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "index",
          "combo",
          "weight",
          "compatibleMass",
          "equity",
          "ev",
          "strategy",
          "actionEv"
        ],
        "additionalProperties": false
      }
    },
    "aggregate": {
      "type": "object",
      "properties": {
        "denominator": {
          "type": "number",
          "minimum": 0
        },
        "frequencies": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string"
              },
              "frequency": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1.000001
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "action",
              "frequency"
            ],
            "additionalProperties": false
          }
        },
        "classes": {
          "maxItems": 169,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hand": {
                "type": "string"
              },
              "probability": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "hand",
              "probability"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "denominator",
        "frequencies",
        "classes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "path",
    "player",
    "counts",
    "node",
    "rows",
    "aggregate"
  ],
  "additionalProperties": false
}
