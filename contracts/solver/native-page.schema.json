{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "nativeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "path": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "terminal": {
      "type": "boolean"
    },
    "actingPlayer": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 1
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "player": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        }
      ]
    },
    "actions": {
      "maxItems": 129,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invested": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "unit": {
      "type": "string",
      "const": "centibb"
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1326
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1326
    },
    "nextOffset": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1326
        },
        {
          "type": "null"
        }
      ]
    },
    "rows": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "engineIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1325
          },
          "combo": {
            "type": "string",
            "pattern": "^(?:[2-9TJQKA][cdhs]){2}$"
          },
          "ownPathWeight": {
            "type": "number",
            "minimum": 0
          },
          "compatibleWeight": {
            "type": "number",
            "minimum": 0
          },
          "equity": {
            "type": [
              "number",
              "null"
            ]
          },
          "ev": {
            "type": [
              "number",
              "null"
            ]
          },
          "strategy": {
            "anyOf": [
              {
                "maxItems": 129,
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "actionEv": {
            "anyOf": [
              {
                "maxItems": 129,
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "engineIndex",
          "combo",
          "ownPathWeight",
          "compatibleWeight",
          "equity",
          "ev",
          "strategy",
          "actionEv"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "nativeSha256",
    "path",
    "terminal",
    "actingPlayer",
    "player",
    "actions",
    "invested",
    "unit",
    "total",
    "offset",
    "nextOffset",
    "rows"
  ],
  "additionalProperties": false
}
