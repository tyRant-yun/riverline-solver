{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "path": {
      "maxItems": 24,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "action"
              },
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 128
              }
            },
            "required": [
              "kind",
              "index"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "deal"
              },
              "card": {
                "type": "string",
                "pattern": "^[2-9TJQKA][cdhs]$"
              }
            },
            "required": [
              "kind",
              "card"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "privateCards": {
      "type": "array",
      "prefixItems": [
        {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "kind": {
      "type": "string",
      "enum": [
        "decision",
        "chance",
        "terminal"
      ]
    },
    "board": {
      "minItems": 3,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[2-9TJQKA][cdhs]$"
      }
    },
    "terminal": {
      "type": "boolean"
    },
    "player": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 1
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "actions": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "chanceCards": {
      "maxItems": 48,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "card": {
            "type": "string",
            "pattern": "^[2-9TJQKA][cdhs]$"
          },
          "probability": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "card",
          "probability"
        ],
        "additionalProperties": false
      }
    },
    "invested": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "weights": {
      "type": "array",
      "prefixItems": [
        {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "compatibleWeights": {
      "type": "array",
      "prefixItems": [
        {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "equity": {
      "type": "array",
      "prefixItems": [
        {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "ev": {
      "type": "array",
      "prefixItems": [
        {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "actionEv": {
      "maxItems": 48,
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "strategy": {
      "maxItems": 48,
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1.000001
      }
    }
  },
  "required": [
    "path",
    "privateCards",
    "kind",
    "board",
    "terminal",
    "player",
    "actions",
    "chanceCards",
    "invested",
    "weights",
    "compatibleWeights",
    "equity",
    "ev",
    "actionEv",
    "strategy"
  ],
  "additionalProperties": false
}
