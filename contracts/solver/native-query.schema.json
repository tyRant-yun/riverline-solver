{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "nativeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "path": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "player": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        }
      ]
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1326
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "maxMemoryBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 268435456
    }
  },
  "required": [
    "schemaVersion",
    "nativeSha256",
    "path",
    "player",
    "offset",
    "limit",
    "maxMemoryBytes"
  ],
  "additionalProperties": false
}
