{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "caseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "board": {
      "minItems": 5,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[2-9TJQKA][cdhs]$"
      }
    },
    "pot": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "stack": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "ranges": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(?:[2-9TJQKA][cdhs]){2}$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(?:[2-9TJQKA][cdhs]){2}$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "sizes": {
      "type": "array",
      "prefixItems": [
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "maxLength": 9
            },
            {
              "type": "string",
              "const": ""
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "const": ""
            },
            {
              "type": "string",
              "const": ""
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxIterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "targetExploitability": {
          "type": "number",
          "minimum": 0
        },
        "maxMemoryBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "maxSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      },
      "required": [
        "maxIterations",
        "targetExploitability",
        "maxMemoryBytes",
        "maxSeconds"
      ],
      "additionalProperties": false
    },
    "locks": {
      "default": [],
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "allocations": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "maxItems": 2,
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "required": [
          "path",
          "allocations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "caseId",
    "board",
    "pot",
    "stack",
    "ranges",
    "sizes",
    "limits",
    "locks"
  ],
  "additionalProperties": false
}
