{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "riverline-engine/1"
    },
    "operation": {
      "type": "string",
      "enum": [
        "solve",
        "cancel"
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "jobId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "attempt": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "specHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "requestId",
        "jobId",
        "attempt",
        "specHash"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "operation",
    "identity"
  ],
  "additionalProperties": false
}
