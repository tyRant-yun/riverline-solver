{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "anyOf": [
        {
          "type": "number",
          "const": 4
        },
        {
          "type": "number",
          "const": 5
        }
      ]
    },
    "nativeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "path": {
      "maxItems": 24,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "action"
              },
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 128
              }
            },
            "required": [
              "kind",
              "index"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "deal"
              },
              "card": {
                "type": "string",
                "pattern": "^[2-9TJQKA][cdhs]$"
              }
            },
            "required": [
              "kind",
              "card"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "maxMemoryBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 268435456
    },
    "player": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        }
      ]
    },
    "indices": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 127
      }
    }
  },
  "required": [
    "schemaVersion",
    "nativeSha256",
    "inputSha256",
    "path",
    "maxMemoryBytes",
    "player",
    "indices"
  ],
  "additionalProperties": false
}
