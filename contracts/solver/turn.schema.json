{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "anyOf": [
        {
          "type": "number",
          "const": 3
        },
        {
          "type": "number",
          "const": 4
        }
      ]
    },
    "caseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "board": {
      "minItems": 4,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[2-9TJQKA][cdhs]$"
      }
    },
    "pot": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "stack": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "ranges": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(?:[2-9TJQKA][cdhs]){2}$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(?:[2-9TJQKA][cdhs]){2}$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxIterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "targetExploitability": {
          "type": "number",
          "minimum": 0
        },
        "maxMemoryBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "maxSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        }
      },
      "required": [
        "maxIterations",
        "targetExploitability",
        "maxMemoryBytes",
        "maxSeconds"
      ],
      "additionalProperties": false
    },
    "locks": {
      "default": [],
      "type": "array",
      "prefixItems": [],
      "items": false,
      "maxItems": 0
    },
    "turnBets": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "riverBets": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  },
  "required": [
    "schemaVersion",
    "caseId",
    "board",
    "pot",
    "stack",
    "ranges",
    "limits",
    "locks",
    "turnBets",
    "riverBets"
  ],
  "additionalProperties": false
}
